+package expo.modules.audio
+
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.Bundle
+import androidx.core.app.NotificationCompat
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.DefaultLoadControl
+import androidx.media3.exoplayer.DefaultRenderersFactory
+import androidx.media3.exoplayer.LoadControl
+import androidx.media3.exoplayer.RenderersFactory
+import androidx.media3.extractor.DefaultExtractorsFactory
+import androidx.media3.extractor.ExtractorsFactory
+import androidx.media3.session.CommandButton
+import androidx.media3.session.SessionCommand
+
+// Muse patch: the player is built from Muse's own renderers (Hi-Res and
+// bit-perfect output, ALAC) and readers (AIFF, DSD, APE, WavPack). Looked up
+// by name so expo-audio needs no build dependency on Muse's module; without
+// it, Media3's defaults are used as before.
+@UnstableApi
+internal object MuseHooks {
+  private val entry: Class<*>? = runCatching { Class.forName("expo.modules.musemetadata.playback.MusePlayback") }.getOrNull()
+
+  fun renderersFactory(context: Context): RenderersFactory =
+    runCatching { entry?.getMethod("renderersFactory", Context::class.java)?.invoke(null, context) as? RenderersFactory }.getOrNull()
+      ?: DefaultRenderersFactory(context)
+
+  fun extractorsFactory(): ExtractorsFactory =
+    runCatching { entry?.getMethod("extractorsFactory")?.invoke(null) as? ExtractorsFactory }.getOrNull()
+      ?: DefaultExtractorsFactory()
+
+  // Keeps the last 15 s in memory, so a small seek back plays from it instead of
+  // re-reading the file (Muse's APE frames are 6.7 s and must be decoded whole).
+  // The byte budget makes room for it: decoded PCM (APE, DSD as 88.2 kHz float)
+  // is large, and the default 13 MB would leave little for the buffer ahead.
+  fun loadControl(): LoadControl =
+    DefaultLoadControl.Builder()
+      .setBackBuffer(15_000, true)
+      .setTargetBufferBytes(32 shl 20)
+      .build()
+
+  // ---- The playback notification ----
+
+  const val ACTION_FAVORITE = "expo.modules.audio.action.MUSE_FAVORITE"
+  const val ACTION_SHUFFLE = "expo.modules.audio.action.MUSE_SHUFFLE"
+  const val CHANNEL_NAME = "Playback"
+
+  val sessionCommands = listOf(SessionCommand(ACTION_FAVORITE, Bundle.EMPTY), SessionCommand(ACTION_SHUFFLE, Bundle.EMPTY))
+
+  /** Muse's bars in the status bar (Muse's module ships the drawable). */
+  fun smallIcon(context: Context): Int =
+    context.resources.getIdentifier("muse_notification_icon", "drawable", context.packageName).takeIf { it != 0 }
+      ?: androidx.media3.session.R.drawable.media3_icon_circular_play
+
+  /** A tap on the notification opens Muse's full player; MuseApp listens for this link. */
+  fun playerIntent(launch: Intent): Intent =
+    Intent(Intent.ACTION_VIEW, Uri.parse("muse://player"))
+      .setComponent(launch.component)
+      .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+
+  /** Called with a Runnable when Muse's ♥ or shuffle changes, so the buttons redraw; null to stop. */
+  fun attach(refresh: Runnable?) {
+    runCatching { entry?.getMethod("setNotificationRefresher", Runnable::class.java)?.invoke(null, refresh) }
+  }
+
+  /** True when the action was Muse's own (♥ or shuffle), handed to Muse. */
+  fun onAction(action: String?): Boolean {
+    val name = when (action) {
+      ACTION_FAVORITE -> "favorite"
+      ACTION_SHUFFLE -> "shuffle"
+      else -> return false
+    }
+    runCatching { entry?.getMethod("onNotificationAction", String::class.java)?.invoke(null, name) }
+    return true
+  }
+
+  private class Extra(val icon: Int, val label: String, val action: String)
+
+  /** -1: hidden (no song), 0: off, 1: on, for ♥ and shuffle. */
+  private fun extras(): List<Extra> {
+    val state = runCatching { entry?.getMethod("notificationButtons")?.invoke(null) as? IntArray }.getOrNull() ?: return emptyList()
+    val favorite = state.getOrElse(0) { -1 }
+    val shuffle = state.getOrElse(1) { -1 }
+    return listOfNotNull(
+      if (favorite < 0) null else if (favorite == 1) {
+        Extra(CommandButton.ICON_HEART_FILLED, "Remove from Favorites", ACTION_FAVORITE)
+      } else {
+        Extra(CommandButton.ICON_HEART_UNFILLED, "Add to Favorites", ACTION_FAVORITE)
+      },
+      if (shuffle < 0) null else if (shuffle == 1) {
+        Extra(CommandButton.ICON_SHUFFLE_ON, "Turn shuffle off", ACTION_SHUFFLE)
+      } else {
+        Extra(CommandButton.ICON_SHUFFLE_OFF, "Turn shuffle on", ACTION_SHUFFLE)
+      },
+    )
+  }
+
+  /** ♥ and shuffle after the transport buttons: Android 13+ shows them in its two extra spots. */
+  fun extraButtons(): List<CommandButton> = extras().map {
+    CommandButton.Builder(it.icon)
+      .setDisplayName(it.label)
+      .setEnabled(true)
+      .setSessionCommand(SessionCommand(it.action, Bundle.EMPTY))
+      .setSlots(CommandButton.SLOT_OVERFLOW)
+      .build()
+  }
+
+  /** The same for Android 12 and older, which draw the notification's own actions. */
+  fun extraActions(pendingIntent: (String) -> PendingIntent): List<NotificationCompat.Action> = extras().map {
+    NotificationCompat.Action(CommandButton.getIconResIdForIconConstant(it.icon), it.label, pendingIntent(it.action))
+  }
+}
