+package expo.modules.audio
+
+import android.content.Context
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.DefaultRenderersFactory
+import androidx.media3.exoplayer.RenderersFactory
+import androidx.media3.extractor.DefaultExtractorsFactory
+import androidx.media3.extractor.ExtractorsFactory
+
+// Muse patch: the player is built from Muse's own renderers (Hi-Res and
+// bit-perfect output, ALAC) and readers (AIFF, DSD, APE, WavPack). Looked up
+// by name so expo-audio needs no build dependency on Muse's module; without
+// it, Media3's defaults are used as before.
+@UnstableApi
+internal object MuseHooks {
+  private val entry: Class<*>? = runCatching { Class.forName("expo.modules.musemetadata.playback.MusePlayback") }.getOrNull()
+
+  fun renderersFactory(context: Context): RenderersFactory =
+    runCatching { entry?.getMethod("renderersFactory", Context::class.java)?.invoke(null, context) as? RenderersFactory }.getOrNull()
+      ?: DefaultRenderersFactory(context)
+
+  fun extractorsFactory(): ExtractorsFactory =
+    runCatching { entry?.getMethod("extractorsFactory")?.invoke(null) as? ExtractorsFactory }.getOrNull()
+      ?: DefaultExtractorsFactory()
+}
