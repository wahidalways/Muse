{
  "name": "muse",
  "version": "1.0.0",
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules",
      "android": {
        "buildFromSource": ["expo-audio"]
      }
    },
    "install": {
      "exclude": [
        "expo-audio"
      ]
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.24",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.11",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-gl": "~58.0.4",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-media-library": "~58.0.14",
    "expo-navigation-bar": "~58.0.4",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-android-widget": "^0.26.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-worklets": "0.13.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/three": "^0.160.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "postinstall": "patch-package"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "private": true
}
