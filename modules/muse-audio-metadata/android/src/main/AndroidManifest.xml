    <package android:name="com.dolby.daxappui" />
    <package android:name="com.dolby.dax2appUI" />
    <package android:name="com.dolby.ds1appUI" />
    <package android:name="com.motorola.dolby.dolbyui" />
  </queries>
</manifest>
